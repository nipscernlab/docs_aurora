# Ambientes e dependências locais.
.venv/
node_modules/

# Artefatos gerados pelo Sphinx e pelas ferramentas auxiliares.
build/
tmp/
tmp-pdfcrop-*.pdf

# O PDF do manual e gerado pelo publish, que o poe aqui para o Sphinx servir;
# nao e fonte, e cada versao pesaria megabytes no historico.
source/_static/downloads/*.pdf

# Arquivos locais do sistema e dos editores.
AGENTS.md
Thumbs.db
.DS_Store
*.log

# Cache do Python gerado ao importar o conf.py fora do Sphinx.
__pycache__/

# Capturas cruas largadas na raiz enquanto se escolhe o enquadramento.
# As que entram no manual vivem em source/_static/assets/screenshots/.
SAPHO_*.png
electron_*.png
